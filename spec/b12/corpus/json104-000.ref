# json_patch('[1,2,3]','{"x":null}')
{}
~~~
# json_patch('[1,2,3]','{"x":null,"y":1,"z":null}')
{"y":1}
~~~
# json_patch('{}','{"a":{"bb":{"ccc":null}}}')
{"a":{"bb":{}}}
~~~
# json_patch('{}','{"a":{"bb":{"ccc":[1,null,3]}}}')
{"a":{"bb":{"ccc":[1,null,3]}}}
~~~
# json_patch('{}','{"a":{"bb":{"ccc":[1,{"dddd":null},3]}}}')
{"a":{"bb":{"ccc":[1,{"dddd":null},3]}}}
~~~
# json_patch('{"a":"b"}','{"a":"c"}')
{"a":"c"}
~~~
# coalesce(json_patch(null,'{"a":"c"}'), 'real-null')
real-null
~~~
# json_patch('{"a":"b"}','{"b":"c"}')
{"a":"b","b":"c"}
~~~
# json_patch('{"a":"b"}','{"a":null}')
{}
~~~
# json_patch('{"a":"b","b":"c"}','{"a":null}')
{"b":"c"}
~~~
# json_patch('{"a":["b"]}','{"a":"c"}')
{"a":"c"}
~~~
# json_patch('{"a":"c"}','{"a":["b"]}')
{"a":["b"]}
~~~
# json_patch('{"a":{"b":"c"}}','{"a":{"b":"d","c":null}}')
{"a":{"b":"d"}}
~~~
# json_patch('{"a":[{"b":"c"}]}','{"a":[1]}')
{"a":[1]}
~~~
# json_patch('["a","b"]','["c","d"]')
["c","d"]
~~~
# json_patch('{"a":"b"}','["c"]')
["c"]
~~~
# json_patch('{"a":"foo"}','null')
null
~~~
# coalesce(json_patch('{"a":"foo"}',null), 'real-null')
real-null
~~~
# json_patch('{"a":"foo"}','"bar"')
"bar"
~~~
